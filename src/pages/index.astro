---
import Layout from '../layouts/Layout.astro';
import {getUniverse,assets} from '../lib/universe';
const {entities}=await getUniverse();
const films=entities.filter(e=>e.sagaOrder).sort((a,b)=>a.sagaOrder!-b.sagaOrder!);
const entrances=[
 {label:'Saga',number:'01',title:'The five-film story',text:'Follow the original team’s public debut, Sinister’s experiments, Mojo’s captivity, the Sentinel crisis and Apocalypse.',href:'/saga/'},
 {label:'Characters',number:'02',title:'People and their journeys',text:'Trace the first class and later allies through changing responsibilities, relationships and allegiances.',href:'/characters/'},
 {label:'World',number:'03',title:'The world around the team',text:'Explore mutant liberation, government enforcement, competing factions and the events that bring them into conflict.',href:'/world/'},
 {label:'Development',number:'04',title:'The creator’s perspective',text:'Read documented influences and answers for invited readers, alongside selected creator commentary.',href:'/development/'}
];
---
<Layout title="X-Men story bible">
<nav class="film-access" aria-label="The five core films">{films.map(f=>{const logo=assets[f.imageIds[0] as keyof typeof assets];return <a href={f.url} style={`--film-color:${f.filmColor}`}><img src={logo.path} alt="" width={logo.width} height={logo.height}/><span><small>Film {f.sagaOrder}</small><strong>{f.title}</strong></span></a>;})}</nav>
<section class="hero home-hero universe-hero"><div class="universe-emblem" aria-hidden="true"><span>X</span><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="saga-spectrum">{films.map(f=><i style={`--film-color:${f.filmColor}`}></i>)}</div></div><div class="hero-copy"><p class="eyebrow">A personal fictional universe / Five connected films</p><h1>The X-Men<br/><em>Universe</em></h1><p class="hero-deck">Xavier’s students become a public team in a world increasingly hostile to mutants. Across five films, their struggle to protect others expands from liberation and persecution to a conflict over the future of mutantkind.</p><a class="button" href="/saga/">Explore the saga <span>↗</span></a><a class="quiet-link" href="/characters/">Meet the characters →</a></div><div class="hero-caption"><span>STORY BIBLE</span><strong>Stories · Characters · A changing world</strong><span>Full spoilers</span></div></section>
<section class="section universe-introduction"><div class="section-heading"><p class="eyebrow">The central conflict</p><h2>Mutants in the<br/>public world</h2><p>The X-Men choose protection as their public mission. Other mutants answer persecution through violent liberation, strength or domination; political and government forces turn public fear into detention and Sentinel enforcement.</p></div><p class="universe-throughline">The films follow the consequences across a changing team: students become leaders, alliances shift, and former X-Men become Apocalypse’s Horsemen. Characters and events carry between stories rather than starting over with each film.</p></section>
<section class="section universe-entrances" aria-label="Explore the universe">{entrances.map(entry=><a class="universe-entry" href={entry.href}><span class="eyebrow">{entry.number} / {entry.label}</span><h2>{entry.title}</h2><p>{entry.text}</p></a>)}</section>
</Layout>
