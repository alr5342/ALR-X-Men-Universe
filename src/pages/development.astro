---
import {withBase} from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import commentary from '../content/creator-notes.json';
import uniformArt from '../design/uniform-art.json';
---
<Layout title="Creator's notes and FAQ"><section class="page-intro"><p class="eyebrow">Outside the fictional universe / Development</p><h1>Creator's notes<br/><em>& FAQ</em></h1><p class="hero-deck">{commentary.intro}</p></section>
<section class="section creator-layout"><div><p class="eyebrow">Documented influence</p><h2>{commentary.influence.title}</h2><p>{commentary.influence.text}</p><details class="evidence"><summary>Reference</summary><p>{commentary.influence.reference}</p></details><a class="arrow-link" href={withBase("/projects/god-loves-man-kills/")}>Read the Film 4 treatment ↗</a></div><aside class="creator-placeholders"><p class="eyebrow">Future owner-written commentary</p>{commentary.futureNotes.map(note=><article><h3>{note.title}</h3><p>{note.description}</p><small>Not yet published</small></article>)}</aside></section>
<section class="section faq"><p class="eyebrow">For shared readers</p><h2>Frequently asked questions</h2>{commentary.faq.map((item,i)=><details open={i===0}><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>
<section class="section creator-credits" id="credits" aria-labelledby="credits-title"><p class="eyebrow">Contributors</p><h2 id="credits-title">Credits</h2><div class="credit-entry"><p>{uniformArt.credit.contribution}</p><div><h3>{uniformArt.credit.name}</h3><p>{uniformArt.credit.handle}</p></div></div></section>
</Layout>
<style>
  .creator-credits{border-top:1px solid var(--line)}
  .credit-entry{display:grid;grid-template-columns:minmax(180px,1fr) 2fr;gap:35px;max-width:1000px;border-top:1px solid var(--line);padding-top:28px}
  .credit-entry>p{font-size:12px;color:var(--gold);margin:0}
  .credit-entry h3{font-size:38px;margin:0 0 12px}
  .credit-entry div p{font-size:14px;margin:0}
  @media(max-width:650px){.credit-entry{grid-template-columns:1fr;gap:18px}}
</style>
